{
  "name": "saathigro-backend",
  "version": "1.0.0",
  "description": "High-performance backend for SaathiGro Quick Commerce",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:env": "node scripts/validate-env.mjs",
    "ci:check": "npm run check:syntax",
    "seed:products": "node src/seedProducts.js",
    "seed:category-page": "node scripts/seed-category-page.mjs",
    "seed:admin": "node seed_admin.js",
    "test": "node --test test/*.test.js",
    "audit:wallet-topups": "node scripts/audit-wallet-topups.mjs",
    "migrate:payment-indexes": "node scripts/create-payment-security-indexes.mjs",
    "migrate:registration-flag": "node scripts/migrate-registration-flag.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "validator": "^13.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "overrides": {
    "multer-storage-cloudinary": {
      "cloudinary": "$cloudinary"
    }
  }
}
